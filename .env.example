# Copy this to .env and fill in your own values. .env is gitignored — never commit it.

# LocalStack Ultimate auth token (from https://app.localstack.cloud/)
LOCALSTACK_AUTH_TOKEN=

# Optional — leave blank to use the deterministic rule-based fallback instead of an LLM.
GEMINI_API_KEY=

# Django
DJANGO_SECRET_KEY=dev-secret-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,merchant-review.local

# Postgres
POSTGRES_DB=merchantreview
POSTGRES_USER=merchantreview
POSTGRES_PASSWORD=merchantreview
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible storage)
S3_ENDPOINT_URL=http://localhost:9010
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
SNAPSHOT_BUCKET=merchant-review-snapshots
