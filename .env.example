# Copy this to .env and fill in your own values. .env is gitignored — never commit it.

# LocalStack Ultimate auth token (from https://app.localstack.cloud/)
LOCALSTACK_AUTH_TOKEN=

# Optional — leave blank to use the deterministic rule-based fallback instead of an LLM.
GEMINI_API_KEY=

# Optional — SRE trainer on-call paging (see README). Leave blank to disable real push
# notifications; pages still fire and file tickets, just silently. Pick a private,
# hard-to-guess topic name — anyone who knows it can subscribe to your ntfy topic.
NTFY_TOPIC=

# LAN address your phone can reach this machine at, for the tap-to-acknowledge button
# on page notifications (see README). Run the dev server on 0.0.0.0, not just 127.0.0.1.
ONCALL_ACK_BASE_URL=http://192.168.1.100:8000

# Optional — when pages are allowed to fire: off-hours (default 11pm-7am) daily, plus all
# day on weekends. Defaults shown; override if your schedule differs.
ONCALL_TIMEZONE=America/Phoenix
ONCALL_OFFHOURS_START_HOUR=23
ONCALL_OFFHOURS_END_HOUR=7

# Django
DJANGO_SECRET_KEY=dev-secret-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,merchant-review.local

# Postgres
POSTGRES_DB=merchantreview
POSTGRES_USER=merchantreview
POSTGRES_PASSWORD=merchantreview
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible storage)
S3_ENDPOINT_URL=http://localhost:9010
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
SNAPSHOT_BUCKET=merchant-review-snapshots
